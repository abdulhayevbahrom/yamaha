CARDXABAR_CHAT_ID=
CARDXABAR_TG_API_ID=
CARDXABAR_TG_API_HASH=
CARDXABAR_TG_USER_SESSION=

GIFT_TG_API_ID=
GIFT_TG_API_HASH=
GIFT_TG_USER_SESSION=

TG_INIT_DATA_MAX_AGE_SEC=86400
TG_INIT_DATA_MAX_AGE_SEC_CRITICAL=600
REQUEST_REPLAY_WINDOW_MS=120000
RATE_LIMIT_USER_WRITE_WINDOW_MS=60000
