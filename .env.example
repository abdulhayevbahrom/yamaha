NODE_ENV=production
PORT=4090
TZ=Asia/Tashkent
ENABLE_NFT_RECIPIENT_LISTENER=true

MONGO_URI=mongodb://127.0.0.1:27017/yamaha
WEB_APP_URL=https://your-frontend.example
CORS_ORIGINS=https://your-frontend.example
TRUST_PROXY=false
SOCKET_ALLOW_NO_ORIGIN=false

BOT_TOKEN=
BOT_USERNAME=
BOT_LINK=
ADMIN_ALLOWED_TG_IDS=
ADMIN_NOTIFY_CHAT_ID=
ADMIN_LOGIN=
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
